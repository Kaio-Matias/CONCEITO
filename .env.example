# Copie para .env (ou cadastre no painel da Vercel em Settings → Environment Variables).

# Domínio oficial do site, sem barra no final. Usado no canonical, na prévia de compartilhamento e no sitemap.xml.
VITE_SITE_URL=https://www.seudominio.com.br

# ID do Google Analytics 4 (Admin → Fluxos de dados → ID da métrica). Sem ele, o Analytics fica desligado.
VITE_GA_ID=G-XXXXXXXXXX

# Opcional: código da tag "google-site-verification" do Google Search Console.
VITE_GSC_VERIFICATION=
